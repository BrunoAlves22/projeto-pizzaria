PORT=3333

DATABASE_URL=postgresql://docker:docker@postgres:5432/pizzaria
JWT_SECRET=replace-with-a-long-random-secret

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

POSTGRES_USER=docker
POSTGRES_PASSWORD=docker
POSTGRES_DB=pizzaria
POSTGRES_PORT=5432

PGUSER=docker
PGDATABASE=pizzaria

# Origens permitidas para CORS, separadas por vírgula (ex: http://localhost:3000,https://app.exemplo.com)
# Se não definida, a API reflete a origem da requisição (use apenas em desenvolvimento).
CORS_ORIGIN=

# Defina quando a API rodar atrás de um reverse proxy / load balancer.
# Número de saltos confiáveis (ex: 1) ou "true". Sem isso o rate limit por IP
# não distingue clientes atrás do proxy.
TRUST_PROXY=

# Usados apenas pelo seed (prisma/seed.ts) para criar o primeiro ADMIN.
# A rota POST /users é restrita a ADMIN, então esta é a conta que provisiona as demais.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
